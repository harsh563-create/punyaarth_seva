# Admin panel login credentials (used by /admin login).
# The email + password are verified against the Supabase `admin_users` table
# (bcrypt-hashed). Seed that table with:  node scripts/seed-admin.mjs
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-strong-password
# Optional display name for the seeded admin account.
ADMIN_NAME=Admin
# Secret used to sign the admin session cookie — change this in production
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Supabase (server-only). When set, content is stored in Supabase and the
# admin panel saves changes through /api/* routes. When unset the site falls
# back to the bundled static data in src data files (demo mode).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
